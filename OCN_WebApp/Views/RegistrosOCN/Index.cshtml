@model IEnumerable<OCN_WebApp.Models.RegistroOCN>

@{
    ViewData["Title"] = "Registros OCN";
}

<h1>Registros de detección (OCN)</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo registro</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Zona</th>
            <th>Problemática</th>
            <th>Intensidad</th>
            <th>Frecuencia</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Zona?.NombreZona</td>            
                <td>@item.Problematica?.NombreProblematica</td>    
                <td>@item.Intensidad</td>                  
                <td>@item.Frecuencia</td>                  
                <td>
                    <a asp-action="Details" asp-route-id="@item.RegistroOCNId" class="btn btn-sm btn-outline-info">Ver</a>
                    <a asp-action="Edit"    asp-route-id="@item.RegistroOCNId" class="btn btn-sm btn-outline-warning">Editar</a>
                    <a asp-action="Delete"  asp-route-id="@item.RegistroOCNId" class="btn btn-sm btn-outline-danger">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>