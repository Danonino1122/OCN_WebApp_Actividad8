@model RegistroOCN

@{
    ViewData["Title"] = "Eliminar un registro";
}

<h1>Eliminar registro</h1>
<h4 class="text-danger">¿Seguro que quieres eliminar este registro? Esta acción no se puede deshacer.</h4>

<div class="card" style="max-width: 32rem;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-5">Id</dt>
            <dd class="col-sm-7">@Model.RegistroOCNId</dd>                 

            <dt class="col-sm-5">Zona</dt>
            <dd class="col-sm-7">@Model.Zona?.NombreZona</dd>           

            <dt class="col-sm-5">Problemática</dt>
            <dd class="col-sm-7">@Model.Problematica?.NombreProblematica</dd>   

            <dt class="col-sm-5">Intensidad (1–5)</dt>
            <dd class="col-sm-7">@Model.Intensidad</dd>                 

            <dt class="col-sm-5">Frecuencia (1–5)</dt>
            <dd class="col-sm-7">@Model.Frecuencia</dd>                 
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">    
    @Html.AntiForgeryToken()                           
    <input type="hidden" asp-for="RegistroOCNId" />              

    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>