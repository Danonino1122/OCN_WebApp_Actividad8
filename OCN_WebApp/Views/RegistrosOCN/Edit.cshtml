@model RegistroOCN

@{
    ViewData["Title"] = "Editar Registro";
}

<h1>Editar registro OCN</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit" method="post">     
            @Html.AntiForgeryToken()              
            <input type="hidden" asp-for="RegistroOCNId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ZonaId" class="form-label">Zona</label>         
                <select asp-for="ZonaId" class="form-select" asp-items="ViewBag.ZonaId">
                    <option value="">-- Elige una zona --</option>
                </select>
                <span asp-validation-for="ZonaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProblematicaId" class="form-label">Problemática</label>  
                <select asp-for="ProblematicaId" class="form-select" asp-items="ViewBag.ProblematicaId">
                    <option value="">-- Elige una problemática --</option>
                </select>
                <span asp-validation-for="ProblematicaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Intensidad" class="form-label">Intensidad (1–5)</label>
                <input asp-for="Intensidad" class="form-control" />
                <span asp-validation-for="Intensidad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Frecuencia" class="form-label">Frecuencia (1–5)</label>
                <input asp-for="Frecuencia" class="form-control" />
                <span asp-validation-for="Frecuencia" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}